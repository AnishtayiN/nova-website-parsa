# نوآوا - فایل .gitignore
# این فایل مشخص می‌کند کدام فایل‌ها نباید در Git قرار گیرند

# تنظیمات محیطی
config.env.php
.env
*.env

# فایل‌های دیتابیس JSON (حاوی اطلاعات حساس)
/data/*.json
!/data/.htaccess

# سشن‌ها و کش
sessions/
session_*
*.session
cache/
*.cache

# لاگ‌ها
logs/
*.log
error_log
error.log

# آپلودها
uploads/
user_uploads/

# فایل‌های موقت
*.tmp
*.temp
*.swp
*.swo
*~

# فایل‌های IDE
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.user

# فایل‌های سیستم عامل
.DS_Store
Thumbs.db

# فایل‌های کامپایل شده
*.min.js
*.min.css
!/js/gsap.min.js
!/js/ScrollTrigger.min.js
!/js/three.min.js

# فایل‌های node_modules (اگر از npm استفاده می‌شود)
node_modules/
package-lock.json

# فایل‌های composer (اگر از PHP Composer استفاده می‌شود)
vendor/
composer.lock

# فایل‌های بیلد
build/
dist/

# فایل‌های بکاپ
*.bak
*.backup
backup/

# فایل‌های تست
coverage/
.phpunit.result.cache

# پایان فایل .gitignore
